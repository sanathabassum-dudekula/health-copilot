# provider:model, e.g. anthropic:..., google_genai:..., openai:...
VISION_MODEL=
TEXT_MODEL=
LLM_API_KEY=
# Optional Web Push keys; background reminders also require CRON_SECRET in the
# backend environment and as a GitHub Actions repository secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
