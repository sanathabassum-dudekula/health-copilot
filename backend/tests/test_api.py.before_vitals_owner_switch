            db.add(document)
            db.flush()
            db.add_all([
                Observation(
                    profile_id=profile.id,
                    document_id=document.id,
                    display_name="Hemoglobin",
                    value_num=10.0,
                    unit="g/dL",
                    interpretation="L",
